# =============================================================================
# .env.example — Elo Fraud Detection System
#
# Copie para .env e preencha os valores reais antes de usar localmente.
# Em produção as variáveis são injetadas via:
#   - K8s ConfigMap  → serviços EKS (inference, process)
#   - Lambda Env Vars → funções Lambda (register-best-model, training-launcher, etl-delta-filter)
#   - Terraform outputs → agente Bedrock
# =============================================================================

# -----------------------------------------------------------------------------
# AWS Global
# -----------------------------------------------------------------------------
AWS_REGION=sa-east-1

# -----------------------------------------------------------------------------
# Serviço de Inferência — services/inference/   (K8s ConfigMap)
# -----------------------------------------------------------------------------
# URI do SageMaker Managed MLflow Tracking Server
MLFLOW_TRACKING_URI=arn:aws:sagemaker:sa-east-1:123456789012:mlflow-app/<app-id>

# Nome do modelo no MLflow Registry (usado para carregar a versão Production)
MODEL_NAME=<nome-do-modelo-no-mlflow-registry>

# URI alternativa de artefato de modelo no S3 (fallback)
MODEL_URI=s3://sagemaker-sa-east-1-123456789012/<experiment-id>/models/<run-id>/artifacts/

# Fila SQS FIFO para publicação de logs de inferência
SQS_QUEUE_URL=https://sqs.sa-east-1.amazonaws.com/123456789012/elo-fraud-resultset-dev.fifo

# Tabela DynamoDB da feature store online
DYNAMO_TABLE=elo-fraud-customer-recent-tx-dev

# -----------------------------------------------------------------------------
# Serviço de Processamento — services/process/   (K8s ConfigMap)
# SQS_QUEUE_URL, DYNAMO_TABLE e AWS_REGION são compartilhadas com o serviço de inferência.
# -----------------------------------------------------------------------------
# Stream Kinesis Firehose para persistência histórica no S3
FIREHOSE_STREAM=elo-fraud-inference-firehose-dev

# -----------------------------------------------------------------------------
# Lambda: register-best-model
# MLFLOW_TRACKING_URI e MODEL_NAME são compartilhadas com o serviço de inferência.
# -----------------------------------------------------------------------------
# Métrica usada para comparar modelos e eleger o melhor
METRIC_TO_COMPARE=f1_score

# Nome da run MLflow que contém o melhor modelo candidato
MLFLOW_BEST_MODEL_RUN=latest

# Tag key/value usada para marcar o modelo promovido no MLflow Registry
MLFLOW_TARGET_TAG_KEY=stage
MLFLOW_TARGET_TAG=production

# -----------------------------------------------------------------------------
# Lambda: training-launcher
# -----------------------------------------------------------------------------
# URI do SageMaker Managed MLflow (pode ser igual a MLFLOW_TRACKING_URI)
MLFLOW_URI=arn:aws:sagemaker:sa-east-1:123456789012:mlflow-app/<app-id>

# Nome do experimento MLflow para registrar as runs de treinamento
MLFLOW_EXPERIMENT_NAME=classificacao_6.0.0

# IAM Role com permissões para o SageMaker Training Job
SAGEMAKER_ROLE=arn:aws:iam::123456789012:role/elo-fraud-sagemaker-role

# Imagem Docker de treinamento no ECR
TRAINING_IMAGE=123456789012.dkr.ecr.sa-east-1.amazonaws.com/elo-fraud-training:latest

# Caminho S3 dos dados de treinamento (Parquet)
DATA_S3_PATH=s3://elo-fraud-data-dev/gold/

# Nome do dataset dentro do S3 path
DATASET_NAME=gold

# Flag para ativar modo produção no script de treinamento
IS_PROD=False

# Tipo de instância SageMaker para o job de treinamento
INSTANCE_TYPE=ml.r5.4xlarge

# -----------------------------------------------------------------------------
# Lambda: etl-delta-filter
# -----------------------------------------------------------------------------
# Bucket S3 de origem (dados brutos)
SOURCE_BUCKET=elo-fraud-raw-dev

# Bucket S3 de destino (dados filtrados/processados)
TARGET_BUCKET=elo-fraud-processed-dev

# -----------------------------------------------------------------------------
# Agente Bedrock — agent_bedrock/
# -----------------------------------------------------------------------------
# ARN do SageMaker Managed MLflow (usado pelas lambdas promotion e statistics)
MLFLOW_APP_ARN=arn:aws:sagemaker:sa-east-1:123456789012:mlflow-app/<app-id>

# Modelo Bedrock para geração de relatórios
BEDROCK_MODEL_ID=anthropic.claude-3-sonnet-20240229-v1:0

# Athena: banco de dados, workgroup e tabela de logs de inferência
ATHENA_DATABASE=elo_fraud_dev_db
ATHENA_WORKGROUP=elo-fraud-athena-workgroup-dev
ATHENA_OUTPUT_S3=s3://aws-athena-query-results-123456789012-sa-east-1/
ATHENA_TABLE=inference_logs

# -----------------------------------------------------------------------------
# Treinamento Local — models/src/   (apenas desenvolvimento local)
# Sobrescreva MLFLOW_TRACKING_URI para apontar ao servidor local:
#   MLFLOW_TRACKING_URI=http://localhost:5000/
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Observabilidade
# -----------------------------------------------------------------------------
LOG_LEVEL=INFO
