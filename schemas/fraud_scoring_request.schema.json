{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "FraudScoringRequest",
  "description": "Requisição para scoring de fraude - campos obrigatórios baseados em relevância para ML",
  "type": "object",
  "required": [
    "transaction_id",
    "card_number",
    "purchase_amount",
    "purchase_currency",
    "purchase_date",
    "device_channel"
  ],
  "properties": {
    "transaction_id": {
      "type": "string",
      "description": "ID único da transação (mapeado de threeDSServerTransID) - IDENTIFICADOR",
      "maxLength": 36,
      "minLength": 36,
      "pattern": "[\\w.-]{36}"
    },
    "card_number": {
      "type": "string",
      "description": "Número do cartão (mapeado de acctNumber) - IDENTIFICADOR + features de BIN",
      "maxLength": 19,
      "minLength": 13,
      "pattern": "\\d{13,19}"
    },
    "purchase_amount": {
      "type": "string",
      "description": "Valor da compra em centavos (mapeado de purchaseAmount) - NUMÉRICO CORE",
      "pattern": "\\d{1,48}"
    },
    "purchase_currency": {
      "type": "string",
      "description": "Código ISO 4217 da moeda (mapeado de purchaseCurrency) - CATEGÓRICA",
      "pattern": "\\d{3}",
      "example": "986"
    },
    "purchase_exponent": {
      "type": "string",
      "description": "Expoente da moeda (mapeado de purchaseExponent) - necessário para converter valor",
      "pattern": "\\d{1}",
      "example": "2"
    },
    "purchase_date": {
      "type": "string",
      "description": "Data da compra YYYYMMDDHHMMSS (mapeado de purchaseDate) - TEMPORAL CORE",
      "pattern": "\\d{14}",
      "example": "20231215120000"
    },
    "device_channel": {
      "type": "string",
      "description": "Canal do dispositivo: 01=App, 02=Browser, 03=3RI (mapeado de deviceChannel) - CATEGÓRICA DISCRIMINATIVA",
      "pattern": "\\d{2}",
      "enum": ["01", "02", "03"]
    },
    "mcc": {
      "type": "string",
      "description": "Merchant Category Code (mapeado de mcc) - CATEGÓRICA DISCRIMINATIVA (risco por categoria)",
      "pattern": "\\d{4}"
    },
    "merchant_country_code": {
      "type": "string",
      "description": "Código do país do comerciante (mapeado de merchantCountryCode) - CATEGÓRICA (cross-border risk)",
      "pattern": "\\d{3}"
    },
    "acquirer_merchant_id": {
      "type": "string",
      "description": "ID do merchant no adquirente (mapeado de acquirerMerchantID) - IDENTIFICADOR (histórico do merchant)",
      "maxLength": 35
    },
    "merchant_document": {
      "type": "string",
      "description": "CNPJ do merchant (mapeado de merchantDocument) - IDENTIFICADOR (validação e histórico)",
      "maxLength": 14
    },
    "cardholder_document": {
      "type": "string",
      "description": "CPF do portador (mapeado de cardHolderDocument) - IDENTIFICADOR (validação e agregações)",
      "maxLength": 11
    },
    "email": {
      "type": "string",
      "description": "Email do cliente (mapeado de email) - IDENTIFICADOR (agregações por email)",
      "format": "email"
    },
    "mobile_phone": {
      "type": "object",
      "description": "Telefone móvel (mapeado de mobilePhone) - IDENTIFICADOR (agregações)",
      "properties": {
        "cc": {
          "type": "string",
          "description": "Código do país",
          "pattern": "\\d{1,3}"
        },
        "subscriber": {
          "type": "string",
          "description": "Número do telefone",
          "pattern": "\\d{1,15}"
        }
      }
    },
    "billing_address": {
      "type": "object",
      "description": "Endereço de cobrança - GEOGRÁFICAS (distância, região)",
      "properties": {
        "city": {
          "type": "string",
          "maxLength": 50
        },
        "state": {
          "type": "string",
          "maxLength": 3
        },
        "postal_code": {
          "type": "string",
          "description": "CEP - importante para geolocalização",
          "maxLength": 16
        },
        "country": {
          "type": "string",
          "pattern": "\\d{3}"
        }
      }
    },
    "shipping_address": {
      "type": "object",
      "description": "Endereço de entrega - GEOGRÁFICAS (distância bill-ship)",
      "properties": {
        "city": {
          "type": "string",
          "maxLength": 50
        },
        "state": {
          "type": "string",
          "maxLength": 3
        },
        "postal_code": {
          "type": "string",
          "maxLength": 16
        },
        "country": {
          "type": "string",
          "pattern": "\\d{3}"
        }
      }
    },
    "addr_match": {
      "type": "string",
      "description": "Indica se endereços coincidem: Y=Sim, N=Não (mapeado de addrMatch) - BINÁRIA DISCRIMINATIVA",
      "pattern": "[YN]"
    },
    "browser_ip": {
      "type": "string",
      "description": "IP do browser (mapeado de browserIP) - IDENTIFICADOR + geolocalização",
      "maxLength": 45,
      "pattern": "[\\w.\\-:]{0,45}"
    },
    "browser_java_enabled": {
      "type": "boolean",
      "description": "Java habilitado no browser - BINÁRIA (bot detection)"
    },
    "browser_javascript_enabled": {
      "type": "boolean",
      "description": "JavaScript habilitado - BINÁRIA (bot detection)"
    },
    "browser_language": {
      "type": "string",
      "description": "Idioma do browser - CATEGÓRICA (consistência geográfica)",
      "maxLength": 35
    },
    "browser_color_depth": {
      "type": "string",
      "description": "Profundidade de cor - NUMÉRICA (device fingerprinting)",
      "maxLength": 2
    },
    "browser_screen_height": {
      "type": "string",
      "description": "Altura da tela - NUMÉRICA (device fingerprinting)",
      "maxLength": 6
    },
    "browser_screen_width": {
      "type": "string",
      "description": "Largura da tela - NUMÉRICA (device fingerprinting)",
      "maxLength": 6
    },
    "browser_tz": {
      "type": "string",
      "description": "Timezone offset em minutos - NUMÉRICA (consistência geográfica)",
      "maxLength": 5
    },
    "browser_user_agent": {
      "type": "string",
      "description": "User agent do browser - CATEGÓRICA (parsing para OS/device)"
    },
    "device_info": {
      "type": "object",
      "description": "Informações do dispositivo (mapeado de device)",
      "properties": {
        "operating_system": {
          "type": "string",
          "description": "CATEGÓRICA",
          "maxLength": 50
        },
        "version": {
          "type": "string",
          "description": "CATEGÓRICA",
          "maxLength": 10
        },
        "name": {
          "type": "string",
          "description": "CATEGÓRICA",
          "maxLength": 50
        },
        "latitude": {
          "type": "string",
          "description": "NUMÉRICA - geolocalização precisa",
          "maxLength": 50
        },
        "longitude": {
          "type": "string",
          "description": "NUMÉRICA - geolocalização precisa",
          "maxLength": 50
        },
        "hash": {
          "type": "string",
          "description": "IDENTIFICADOR - device fingerprint"
        }
      }
    },
    "acct_info": {
      "type": "object",
      "description": "Informações da conta (mapeado de acctInfo) - AGREGAÇÕES TEMPORAIS IMPORTANTES",
      "properties": {
        "ch_acc_age_ind": {
          "type": "string",
          "description": "Indicador de idade da conta - CATEGÓRICA ORDINAL (novo cliente = risco)",
          "maxLength": 2
        },
        "ch_acc_change_ind": {
          "type": "string",
          "description": "Indicador de mudança na conta - CATEGÓRICA (mudança recente = risco)",
          "maxLength": 2
        },
        "ch_acc_pw_change_ind": {
          "type": "string",
          "description": "Indicador de mudança de senha - CATEGÓRICA (takeover risk)",
          "maxLength": 2
        },
        "nb_purchase_account": {
          "type": "string",
          "description": "Número de compras nos últimos 6 meses - NUMÉRICA (velocity)",
          "maxLength": 4
        },
        "txn_activity_day": {
          "type": "string",
          "description": "Transações nas últimas 24h - NUMÉRICA CRÍTICA (velocity)",
          "maxLength": 3
        },
        "txn_activity_year": {
          "type": "string",
          "description": "Transações no último ano - NUMÉRICA (comportamento)",
          "maxLength": 3
        },
        "suspicious_acc_activity": {
          "type": "string",
          "description": "Atividade suspeita: 01=Sim, 02=Não - BINÁRIA DISCRIMINATIVA",
          "maxLength": 2
        },
        "provision_attempts_day": {
          "type": "string",
          "description": "Tentativas de provisionamento no dia - NUMÉRICA (enumeration attack)",
          "maxLength": 3
        }
      }
    },
    "payment_info": {
      "type": "object",
      "description": "Informações de pagamento (mapeado de paymentInfo) - AGREGAÇÕES TEMPORAIS",
      "properties": {
        "cof_number": {
          "type": "integer",
          "description": "Número de credenciais armazenadas - NUMÉRICA"
        },
        "cof_number_24h": {
          "type": "integer",
          "description": "COF nas últimas 24h - NUMÉRICA (velocity)"
        },
        "cof_number_7d": {
          "type": "integer",
          "description": "COF nos últimos 7 dias - NUMÉRICA (velocity)"
        },
        "cof_date": {
          "type": "string",
          "format": "date-time",
          "description": "Data da última COF - TEMPORAL (recency)"
        }
      }
    },
    "merchant_risk_indicator": {
      "type": "object",
      "description": "Indicadores de risco do merchant",
      "properties": {
        "delivery_timeframe": {
          "type": "string",
          "description": "Prazo de entrega - CATEGÓRICA ORDINAL (entrega eletrônica = risco diferente)",
          "maxLength": 2
        },
        "reorder_items_ind": {
          "type": "string",
          "description": "Recompra - BINÁRIA (primeira compra = mais risco)",
          "maxLength": 2
        },
        "pre_order_purchase_ind": {
          "type": "string",
          "description": "Pré-venda - BINÁRIA",
          "maxLength": 2
        },
        "ship_indicator": {
          "type": "string",
          "description": "Método de envio - CATEGÓRICA",
          "maxLength": 2
        },
        "gift_card_amount": {
          "type": "string",
          "description": "Valor em gift card - NUMÉRICA (gift cards = alto risco)",
          "maxLength": 15
        },
        "gift_card_count": {
          "type": "string",
          "description": "Quantidade de gift cards - NUMÉRICA CRÍTICA (múltiplos = red flag)",
          "maxLength": 2
        }
      }
    },
    "three_ds_trans_status": {
      "type": "string",
      "description": "Status da autenticação 3DS - CATEGÓRICA DISCRIMINATIVA (Y=autenticado é menos risco)",
      "pattern": "[A-Z]",
      "enum": ["Y", "N", "U", "A", "C", "D", "R", "I"]
    },
    "three_ds_trans_status_reason": {
      "type": "string",
      "description": "Razão do status 3DS - CATEGÓRICA (detalhes da falha)",
      "pattern": "\\d{2}"
    },
    "three_ds_eci": {
      "type": "string",
      "description": "ECI do 3DS - CATEGÓRICA (nível de autenticação)",
      "pattern": "\\w{2}"
    },
    "product_type": {
      "type": "string",
      "description": "Tipo de produto Elo - CATEGÓRICA",
      "enum": ["THREE_DS_AND_ONLINE_PURCHASE", "ONLINE_PURCHASE", "THREE_DS"]
    },
    "is_direct_selling": {
      "type": "boolean",
      "description": "Venda direta - BINÁRIA"
    },
    "is_quick_withdrawal": {
      "type": "boolean",
      "description": "Saque rápido - BINÁRIA CRÍTICA (saque = alto risco)"
    },
    "sku": {
      "type": "object",
      "description": "Informações do produto - CATEGÓRICAS",
      "properties": {
        "code": {
          "type": "string",
          "description": "Código SKU - IDENTIFICADOR (produtos de risco)"
        },
        "category": {
          "type": "string",
          "description": "Categoria - CATEGÓRICA (eletrônicos = mais risco)"
        },
        "sub_category": {
          "type": "string",
          "description": "Subcategoria - CATEGÓRICA"
        }
      }
    },
    "purchase_instal_data": {
      "type": "string",
      "description": "Número de parcelas - NUMÉRICA (muitas parcelas pode indicar risco)",
      "maxLength": 3
    },
    "recurring_ind": {
      "type": "object",
      "description": "Indicadores de recorrência - BINÁRIA/CATEGÓRICA",
      "properties": {
        "amount_ind": {
          "type": "string",
          "description": "Indicador de valor recorrente",
          "maxLength": 2
        },
        "frequency_ind": {
          "type": "string",
          "description": "Indicador de frequência",
          "maxLength": 2
        }
      }
    }
  },
  "additionalProperties": false
}
